# Simulation-only project: no pin assignments are required.
# For hardware, use the master XDC for the exact board and uncomment/edit:
# create_clock -name sys_clk -period 10.000 [get_ports clk]
# set_property PACKAGE_PIN <REAL_PIN> [get_ports clk]
# set_property IOSTANDARD LVCMOS33 [get_ports clk]
# Never use guessed PACKAGE_PIN values. Set clock period from board oscillator.
